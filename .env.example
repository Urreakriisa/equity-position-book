# Copy to .env for local runs. On Railway, set these in the service's Variables tab.
ALPHAVANTAGE_API_KEY=
APP_PASSWORD=
# Optional second password that can look but not edit:
VIEW_PASSWORD=
# Any long random string; keeps people signed in across restarts:
SECRET_KEY=
# delayed (15-minute), realtime, or none:
AV_ENTITLEMENT=delayed
# Seconds between price refreshes while the US market is open:
QUOTE_INTERVAL=60
# Provided by Railway's Postgres service. Leave empty locally to use a SQLite file:
DATABASE_URL=
